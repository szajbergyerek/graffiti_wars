SECRET_KEY=change-me-to-a-long-random-string

DATABASE_NAME=graffiti_wars
DATABASE_USER=graffiti_wars
DATABASE_PASS=change-me

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

STORAGE_PATH=/path/on/your/host

# Optional: which image the web service runs. Defaults to the image the
# repo's own CI builds and pushes (ghcr.io/graffiti-war/website:latest) -
# override to pin a specific commit tag or point at a different registry.
# WEB_IMAGE=ghcr.io/graffiti-war/website:latest

# Optional, local testing only: set to "true" to skip Google login and always
# be signed in as a fixed local admin account. Never set this in a real
# deployment. Useful when testing from a phone over a plain-HTTP LAN address,
# where Google OAuth's HTTPS requirement can't be satisfied.
DEV_AUTO_LOGIN=false
