# Copy this file to .env (next to docker-compose.yml) and fill in real values.
# In Portainer: create the stack from this repo, then set these as the
# stack's environment variables instead of uploading a .env file.

SECRET_KEY=change-me-to-a-long-random-string

DATABASE_NAME=graffiti_wars
DATABASE_USER=graffiti_wars
DATABASE_PASS=change-me

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
